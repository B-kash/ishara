# Ishara API — copy to .env and adjust (never commit .env)

# HTTP server
PORT=3000
HOST=0.0.0.0

# mock = data/mock-signs.json (no database)
# postgres = PostgreSQL via DATABASE_URL
DATA_SOURCE=mock

# Required when DATA_SOURCE=postgres
# Example: postgresql://user:password@localhost:5432/ishara
DATABASE_URL=

# Allowed browser origins for the Flutter web app (comma-separated).
# Use * or leave empty for local dev (allow all origins).
# Production example: https://ishara.example.com
CORS_ORIGIN=
